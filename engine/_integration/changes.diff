+            if (Environment.TickCount64 >= next)
+            {
+                try { Volatile.Write(ref maintenance, core.Poll()); }
+                catch (Exception ex) { Volatile.Write(ref maintenance, new(false, "MaintenanceFailure", null, core.Count, [new("Exception", "", ex.Message)])); }
