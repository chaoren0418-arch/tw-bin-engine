+            var gain = driver.Gain(voice.Alias, next.CanDispatch ? next.Gain : 0);
+            if (!gain.Ok) { failed = true; events.Add(Native("GainFailed", voice.Format, gain)); }
+            if (!next.CanDispatch || !gain.Ok) Release(voice, events);
+        }
