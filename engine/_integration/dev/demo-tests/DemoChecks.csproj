<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework><UseWindowsForms>true</UseWindowsForms><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <!-- T270 (#645): automatic discovery. Every ../*-tests folder WITHOUT its own .csproj is a DemoChecks module and all of its
       .cs files compile here; test groups come from [CheckGroup] attributes (AutoDiscovery.cs). Do not list files here. -->
  <ItemGroup>
    <_DemoOwnProject Include="../*-tests/*.csproj" />
    <_DemoNotModule Include="@(_DemoOwnProject->'%(RelativeDir)**/*.cs')" />
    <Compile Include="../*-tests/**/*.cs" Exclude="@(_DemoNotModule);../*-tests/**/bin/**;../*-tests/**/obj/**" Link="%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="P11.ClientEngine"><HintPath>../../../build/client-product-dev/P11.ClientEngine.dll</HintPath></Reference>
    <Reference Include="P24.Audio"><HintPath>../../../build/client-product-dev/P24.Audio.dll</HintPath></Reference>
  </ItemGroup>
</Project>
