<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <!-- Keep identical source inputs reproducible across checkout paths and Git commits. -->
    <EnableSourceLink>false</EnableSourceLink>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Deterministic>true</Deterministic>
    <PathMap Condition="'$(Configuration)' == 'Release'">$(MSBuildProjectDirectory)=/_/p24/audio</PathMap>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources/combat-sfx-pins.json" LogicalName="P24.Audio.CombatSfxPins.json" />
    <InternalsVisibleTo Include="CombatSfxChecks" />
    <InternalsVisibleTo Include="SoundRulesChecks" />
    <!-- T460 (#1045): synthetic-WAV client-root checks ([CheckGroup] audio-provider) and the 6016 native regression use synthetic pins. -->
    <InternalsVisibleTo Include="DemoChecks" />
    <InternalsVisibleTo Include="Effect6016Checks" />
    <!-- T302: SoundVolumeUpdateTests (module tests in the product assembly) drive AudioCore with a fake driver. -->
    <InternalsVisibleTo Include="P11.ClientEngine" />
  </ItemGroup>
</Project>
